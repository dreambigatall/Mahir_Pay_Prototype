# =============================================================================
# Backend environment template
# Copy to backend/.env for local use. On Render, set these in the service
# Environment tab — never commit real secrets.
# =============================================================================

# --- Runtime ---
# Local: development | Render: production
NODE_ENV=development
# Local default 4000. On Render, PORT is injected automatically — keep reading process.env.PORT.
PORT=4000
LOG_LEVEL=info

# --- Database (Supabase Postgres or any hosted Postgres) ---
# Prefer the pooled URL for the running API.
DATABASE_URL="postgresql://postgres.PROJECT_REF:URL_ENCODED_PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Direct (non-pooler) URL is useful for migrations / admin scripts when available.
DIRECT_URL="postgresql://postgres.PROJECT_REF:URL_ENCODED_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres"
DATABASE_SSL=true
DATABASE_POOL_MAX=10
DATABASE_STATEMENT_TIMEOUT_MS=10000

# --- CORS / proxy ---
# Must match the browser origin of the Next.js app (scheme + host, no path).
# Local: http://localhost:3000
# Render: https://YOUR-FRONTEND.onrender.com  ← wrong value breaks login (CORS)
FRONTEND_ORIGIN=http://localhost:3000
# Local: false. On Render: true (service runs behind Render's proxy).
TRUST_PROXY=false

# --- Auth / sessions ---
SESSION_COOKIE_NAME=mahir_clinic_session
SESSION_TTL_HOURS=12
SESSION_IDLE_MINUTES=30
# Must be at least 32 characters. Generate a unique value for production and keep it secret.
PASSWORD_PEPPER=replace-with-at-least-32-random-characters

# --- One-time admin seed scripts only (not required for normal API boot) ---
INITIAL_ADMIN_EMAIL=admin@example.com
INITIAL_ADMIN_PASSWORD=replace-with-a-temporary-password
INITIAL_ADMIN_NAME=Clinic Administrator

# =============================================================================
# Suggested Render (API Web Service) values
# =============================================================================
# NODE_ENV=production
# TRUST_PROXY=true
# FRONTEND_ORIGIN=https://YOUR-FRONTEND.onrender.com
# DATABASE_SSL=true
# LOG_LEVEL=info
# PASSWORD_PEPPER=<unique-32+-char-secret>
# DATABASE_URL=<prod-postgres-url>
# DIRECT_URL=<prod-direct-postgres-url-optional>
