NODE_ENV=development
PORT=4000
LOG_LEVEL=info
DATABASE_URL="postgresql://postgres.PROJECT_REF:URL_ENCODED_PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.PROJECT_REF:URL_ENCODED_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres"
DATABASE_SSL=true
DATABASE_POOL_MAX=10
DATABASE_STATEMENT_TIMEOUT_MS=10000
FRONTEND_ORIGIN=http://localhost:3000
TRUST_PROXY=false
SESSION_COOKIE_NAME=mahir_clinic_session
SESSION_TTL_HOURS=12
SESSION_IDLE_MINUTES=30
PASSWORD_PEPPER=replace-with-at-least-32-random-characters
INITIAL_ADMIN_EMAIL=admin@example.com
INITIAL_ADMIN_PASSWORD=replace-with-a-strong-temporary-password
INITIAL_ADMIN_NAME=Clinic Administrator


