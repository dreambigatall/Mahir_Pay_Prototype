# =============================================================================
# Frontend environment template
# Copy to frontend/.env.local for local use.
# On Render, set NEXT_PUBLIC_API_URL in the Static Site / Web Service env vars.
# Next.js inlines NEXT_PUBLIC_* at build time — set it before/during build.
# =============================================================================

# Local API
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1

# =============================================================================
# Suggested Render (frontend) value
# =============================================================================
# NEXT_PUBLIC_API_URL=https://YOUR-API.onrender.com/api/v1
