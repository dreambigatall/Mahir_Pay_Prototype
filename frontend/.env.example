# =============================================================================
# Frontend environment template
# Copy to frontend/.env.local for local use.
# =============================================================================

# --- Local (talk to API directly) ---
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1

# --- Render (REQUIRED for login sessions) ---
# Use a same-origin path so the session cookie sticks on the frontend host.
# Set BOTH before build/redeploy of the frontend service:
#
# NEXT_PUBLIC_API_URL=/api/v1
# API_PROXY_TARGET=https://mahir-pay-prototype.onrender.com
#
# API_PROXY_TARGET = your Express service origin (no /api/v1 suffix).
# Next rewrites /api/v1/* → that backend. Rebuild after changing these.
